# ---- Discord application ------------------------------------------------------
# https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs allowed to skip / queue. Empty = everyone.
CONTROL_USER_IDS=

# ---- Jellyfin -----------------------------------------------------------------
# Only this server talks to Jellyfin, so a LAN address is fine.
JELLYFIN_URL=http://localhost:8096
# Dashboard -> API Keys -> +
JELLYFIN_API_KEY=
# Optional: only play what this Jellyfin user can see. A username or a user ID.
JELLYFIN_USER_ID=
# Optional: comma-separated library / folder / series / playlist / collection IDs.
# Open the item in the Jellyfin web UI; the ID is the "id=" part of the URL.
JELLYFIN_PARENT_IDS=
JELLYFIN_ITEM_TYPES=Movie,Episode
# "random" = shuffle everything. Otherwise a Jellyfin SortBy, e.g.
# "SeriesSortName,ParentIndexNumber,IndexNumber" for shows in order.
JELLYFIN_ORDER=random

# ---- Streaming ----------------------------------------------------------------
# Per-viewer limits. Each viewer gets their own stream from Jellyfin, so your
# upload speed needs roughly MAX_BITRATE_KBPS x number of viewers.
MAX_BITRATE_KBPS=8000
MAX_HEIGHT=1080

# ---- Server -------------------------------------------------------------------
PORT=8080
# Lets you open http://localhost:8080 in a normal browser without Discord, for
# testing. Anyone who can reach the server can then watch, so keep it off
# when the tunnel is running.
DEV_AUTH=false
