# ---- Discord ---------------------------------------------------------------
# Token of the *user account* that will stream (see README: bot accounts
# cannot Go Live). Use a throwaway alt account.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to use !skip, !play, etc.
ALLOWED_USER_IDS=
COMMAND_PREFIX=!

# ---- Jellyfin --------------------------------------------------------------
JELLYFIN_URL=http://jellyfin.local:8096
# Dashboard -> API Keys -> +
JELLYFIN_API_KEY=
# Optional: restrict to what this user can see (Dashboard -> Users -> URL has userId)
JELLYFIN_USER_ID=
# Optional: comma-separated library / folder / series / playlist / collection IDs.
# Open the item in the Jellyfin web UI; the ID is the "id=" part of the URL.
JELLYFIN_PARENT_IDS=
JELLYFIN_ITEM_TYPES=Movie,Episode
# "random" = shuffle everything. Otherwise a Jellyfin SortBy, e.g.
# "SeriesSortName,ParentIndexNumber,IndexNumber" for shows in order.
JELLYFIN_ORDER=random

# ---- Stream quality --------------------------------------------------------
# Every item is scaled/letterboxed to this size so the stream never changes shape.
STREAM_HEIGHT=720
STREAM_FPS=30
STREAM_BITRATE_KBPS=3000
STREAM_BITRATE_MAX_KBPS=4500
STREAM_AUDIO_BITRATE_KBPS=128
# H264 or H265
STREAM_CODEC=H264
# software | nvenc | vaapi
STREAM_ENCODER=software
# x264 preset when STREAM_ENCODER=software (ultrafast..medium)
STREAM_PRESET=veryfast
STREAM_HW_DECODE=false
# go-live (screen share) or camera
STREAM_TYPE=go-live

# Show "Watching <title>" as the account's status
SET_STATUS=true
